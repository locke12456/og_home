{%- assign t = site.data.i18n[include.lang] -%}
{%- assign posts = site.posts | where: "lang", include.lang -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ include.lang }}">
  <title>{{ t.brand | xml_escape }} · {{ t.devlog_title | xml_escape }}</title>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ t.base | append: '/devlog/' | absolute_url }}" rel="alternate" type="text/html" hreflang="{{ include.lang }}"/>
  <id>{{ page.url | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>Locke Studio</name></author>
  {%- for post in posts limit:20 %}
  <entry>
    <title type="html">{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    {%- if post.description %}
    <summary type="html">{{ post.description | xml_escape }}</summary>
    {%- endif %}
    <content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
